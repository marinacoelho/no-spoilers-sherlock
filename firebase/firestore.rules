rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read: if true;
      allow write: if false;
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if false;
    }
    match /chunks/{chunkId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
